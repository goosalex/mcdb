# TT.UTIL -- the scheduled jobs and the one directly-called routine: check_resolved_tickets
# (S-UTIL-001: resolved for 14+ days -> closed via change_status, close_date stamped,
# notifications deleted through OSAG_NOTIFY), check_ticket_status (S-UTIL-002: statuses
# 11/12/60/61 with an expired status_valid_until_date -> expire_status -> hot, the deferred
# ticket is "resurrected" too), check_dnids_tickets_to_resolve (S-UTIL-008: type-5 tickets
# whose last public event is a 10020 scan event older than 7 days or matching
# ^DNIDS:SCAN:INFO:ALLCLEAN / ^DNIPS:SLOWDOWN:ALLCLEAN with the 'im' flags -> resolved) and
# update_status_valid_until (S-UTIL-003..007: +20d / +4h defaults, the 60d / 1d caps on an
# explicit date, a past explicit date ignored, deferred no-op, reset to NULL for other statuses,
# last_deferral_date overwritten for the waiting family, NO_DATA_FOUND propagates).
#
# The check_* routines scan ALL tickets: the fixtures provide eligible and ineligible tickets
# side by side and every probe selects the fixture ids only (958310-958347). The update steps
# run BEFORE check_ticket_status so that no fixture of the update group is expired when the
# job scans. Dates are relative to CURRENT_TIMESTAMP inside one INSERT (the same statement
# clock on both engines), so the expire text "for 24 hours" is deterministic; the probes test
# the written dates as windows (19..21 days, 3..5 hours), never as absolute values.
#
# ORA_USER=system: the fixtures insert into stop.company, stop.contact, mss.host and
# auth.login; TT holds only SELECT on those. Everything is rolled back at the end (COMMITS=no).
ORA_USER=system
COMMITS=no
COMPARE_MSG=no
DESCRIPTION=check_resolved_tickets, update_status_valid_until (9 cases), check_ticket_status, check_dnids_tickets_to_resolve on tickets 958310-958347
