# TT.TICKET_INTERFACE -- newticket_new / change_worker as changed by the 2026-10-20 export
# (S-TICKET-061..063): ServiceNow sign-off senders known only by Zitadel user ID are mapped
# to their auth.login contact, the change-request rule also fires for them, and both routines
# write tt.ticket.worker_zitadel_id. Seven newticket_new calls + one change_worker, then the
# ticket rows, change requests and first events are compared (ids are sequence-generated and
# differ between the engines, so probes select by subject and never expose ticket/event ids).
#
# ORA_USER=system: the fixtures insert into stop.company, stop.contact, mss.host, mss.service,
# mss.host2service and auth.login; TT holds only SELECT on those. Rolled back at the end.
ORA_USER=system
COMMITS=no
COMPARE_MSG=no
DESCRIPTION=newticket_new sign-off senders by Zitadel ID, change-request rule, worker_zitadel_id on insert and change_worker (2026-10-20 export)
