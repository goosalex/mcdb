# TT.TICKET_INTERFACE -- change_status open->hot->waiting->closed, change_subject, and the
# NO_DATA_FOUND error path on a nonexistent ticket; probes the ticket row, the tt.event
# rows written, ticket_flow and ticket_time_statistic.
#
# ORA_USER=system, not tt: the fixtures insert into stop.company, stop.contact and mss.host,
# and the TT schema user holds only SELECT/REFERENCES on those tables
# (ddl/generated/grants: "GRANT SELECT ON STOP.COMPANY TO TT"). SYSTEM (password = the
# container's ORACLE_PASSWORD) can write them. The routines are definer-rights package
# procedures, so the caller's identity does not change what they do; every call is
# schema-qualified. Everything is rolled back at the end (COMMITS=no); only the plog
# audit rows written through osag_plog's AUTONOMOUS_TRANSACTION survive on Oracle.
ORA_USER=system
COMMITS=no
COMPARE_MSG=no
DESCRIPTION=ticket 950010: change_status 2->3->11->102, change_subject, NO_DATA_FOUND on ticket 950999999
