# TT.TICKET_INTERFACE -- rate_ticket (S-TICKET-039: engineer vs customer rating column,
# only a bad customer rating < 3 forces the ticket hot), trigger_escalation (S-TICKET-038:
# public 100007 history event with NULL host/company, exec_event_type_actions has no action
# rows for 100007 on either side, swallow-all handler) and updateTicketFlow (S-TICKET-051,
# S-TICKET-056: insert into the MCC queue, take out, accumulate open_time from the later of
# flow_in_date and the previous status-change date). open_time values are compared as
# buckets (~1800 / ~2700 / ~3600 s) because both engines measure elapsed wall-clock time.
#
# ORA_USER=system: the fixtures insert into stop.company, stop.contact, mss.host,
# mss.service and mss.host2service; TT holds only SELECT on those. Rolled back at the end.
ORA_USER=system
COMMITS=no
COMPARE_MSG=no
DESCRIPTION=rate_ticket (engineer/customer/bad customer -> hot), trigger_escalation, updateTicketFlow queue in/out and open_time on tickets 954210-954219
