# MSS.OSAG_IP -- the pure conversion functions over a table of inputs.
# One diff_probe row per input; both sides are expected to agree on every row
# (every input here is covered by a non-deviating clause of migration/spec/mss.osag_ip.md).
# The documented DEVIATION(ORACLE-BUG) inputs live in mss__osag_ip__oracle_bugs.
ORA_USER=mss
COMMITS=no
COMPARE_MSG=no
DESCRIPTION=ip2num/num2ip/getnet/getbcast/ipv6left/ipv6right/num2ipv6 over valid and malformed inputs (S-IP-001..007, 010..013, 015..019, 021..022)
